{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@models/*": ["lib/models/*"],
      "@dto/*": ["lib/dto/*"],
      "@state/*": ["lib/state/*"],
      "@services/*": ["lib/services/*"],
      "@tinyfx/runtime": ["../../runtime/src/index.ts"],
      "@tinyfx/runtime/*": ["../../runtime/src/*"]
    }
  },
  "include": ["main.ts", "components/**/*.ts", "lib/**/*.ts"]
}
